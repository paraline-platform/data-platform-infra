# ============================================================
# HELMFILE.YAML.GOTMPL — Khai báo toàn bộ platform releases
# ============================================================
# Đuôi .gotmpl bắt buộc từ Helmfile v1 khi dùng template syntax .Values
#
# Luồng hoạt động:
#   environments/*.yaml  →  .Values  →  values/env/*.gotmpl  →  Helm chart
#
# Cách dùng (từ thư mục platform/):
#   Deploy toàn bộ:      ./scripts/deploy.sh stg
#   Deploy 1 layer:      ./scripts/deploy.sh stg 02-storage
#   Xem diff:            ./scripts/deploy.sh stg "" diff
#   Xóa toàn bộ:         ./scripts/deploy.sh stg "" destroy
#
# Layer model:
#   00-infra        Ingress controller
#   01-ingestion    Kafka/Strimzi, Debezium CDC, NiFi
#   02-storage      MinIO (object storage)
#   03-processing   Spark Operator
#   04-lakehouse    HMS (Postgres + Hive Metastore), Spark Thrift Server
#   05-governance   DataHub (TODO)
#   06-orchestration Airflow
#   07-observability Prometheus + Grafana (TODO)
# ============================================================

# Document 1: environments (PHẢI tách riêng bằng ---)
# P1.4: _defaults.yaml load TRƯỚC (baseline đầy đủ mọi key mà gotmpl tham chiếu),
# env file merge đè lên sau → env file chỉ chứa phần KHÁC defaults.
# P1: secrets/ (SOPS-encrypted) load SAU CÙNG — đè password rỗng trong defaults.
# Cần: helm plugin helm-secrets + age key tại $SOPS_AGE_KEY_FILE (CI: secret SOPS_AGE_KEY)
environments:
  stg:
    values:
      - environments/_defaults.yaml
      - environments/stg.yaml
      - spark-profiles/stg.yaml     # → .Values.profiles available in all gotmpl templates
    secrets:
      - environments/secrets/stg.yaml
  uat:
    values:
      - environments/_defaults.yaml
      - environments/uat.yaml
      - spark-profiles/prd.yaml     # uat dùng prd profiles (resource đủ lớn)
    secrets:
      - environments/secrets/uat.yaml
  prd:
    values:
      - environments/_defaults.yaml
      - environments/prd.yaml
      - spark-profiles/prd.yaml
    secrets:
      - environments/secrets/prd.yaml

---
# Document 2: repositories + helmDefaults + releases

repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: strimzi
    url: https://strimzi.io/charts/
  - name: spark-operator
    url: https://kubeflow.github.io/spark-operator
  - name: airflow
    url: https://airflow.apache.org
  - name: datahub
    url: https://helm.datahubproject.io/
  - name: apache-nifi
    url: https://cetic.github.io/helm-charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx
  - name: minio
    url: https://charts.min.io/

helmDefaults:
  wait: true
  timeout: 600
  atomic: true
  cleanupOnFail: true

releases:

  # ==========================================================
  # LAYER 00: INFRASTRUCTURE — Ingress Controller
  # ==========================================================
  # TODO Phase: tạo values/base/ingress-nginx.yaml rồi bật lại
  # stg  → global.ingress.enabled: false → bỏ qua, dùng NodePort
  # prd  → global.ingress.enabled: true  → deploy ingress-nginx
  # - name: ingress-nginx
  #   namespace: data-infra
  #   chart: ingress-nginx/ingress-nginx
  #   version: "4.10.0"
  #   labels:
  #     layer: "00-infra"
  #   NOTE: file .gotmpl được render TRƯỚC khi parse YAML nên dấu # KHÔNG bảo vệ
  #   được biểu thức {{`{{ }}`}} — phải escape khi để trong comment.
  #   Khi bật lại release, dùng dạng nil-safe để env thiếu key không làm vỡ render:
  #   installed: {{`{{ .Values | get "global.ingress.enabled" false }}`}}
  #   values:
  #     - values/base/ingress-nginx.yaml

  # ==========================================================
  # LAYER 01: INGESTION — Kafka (Strimzi Operator)
  # ==========================================================
  - name: strimzi-operator
    namespace: data-ingestion
    chart: strimzi/strimzi-kafka-operator
    version: "0.51.0"
    labels:
      layer: "01-ingestion"
    values:
      - values/base/strimzi-operator.yaml

  - name: kafka-cluster
    namespace: data-ingestion
    chart: ./charts/kafka-cluster
    labels:
      layer: "01-ingestion"
    needs:
      - data-ingestion/strimzi-operator
    values:
      - values/base/kafka-cluster.yaml
      - values/env/kafka-cluster.yaml.gotmpl

  # ==========================================================
  # LAYER 01: INGESTION — Debezium CDC
  # ==========================================================
  # Chart: local (./charts/debezium)
  # Components: demo-postgres + KafkaConnect (Strimzi) + KafkaConnector
  # KafkaConnect dùng image quay.io/debezium/connect:3.0.0.Final
  - name: debezium
    namespace: data-ingestion
    chart: ./charts/debezium
    labels:
      layer: "01-ingestion"
      component: debezium
    wait: false
    atomic: false
    timeout: 600
    needs:
      - data-ingestion/kafka-cluster
    values:
      - values/base/debezium.yaml
      - values/env/debezium.yaml.gotmpl

  # ==========================================================
  # LAYER 01: INGESTION — NiFi
  # ==========================================================
  # Chart: cetic community chart
  # Auth:  Single User + HTTPS (self-signed cert)
  # UI:    https://localhost:8443/nifi  (dev, port-forward)
  - name: nifi
    namespace: data-ingestion
    chart: apache-nifi/nifi
    version: "1.2.1"
    labels:
      layer: "01-ingestion"
      component: nifi
    # NiFi lần đầu start mất 3-5 phút (generate SSL certs + init flow)
    wait: false
    atomic: false
    timeout: 900
    needs:
      - data-storage/minio
      - data-ingestion/kafka-cluster
    values:
      - values/base/nifi.yaml
      - values/env/nifi.yaml.gotmpl

  # ==========================================================
  # LAYER 02: STORAGE — MinIO
  # ==========================================================
  - name: minio
    namespace: data-storage
    chart: minio/minio
    version: "5.4.0"
    labels:
      layer: "02-storage"
    values:
      - values/base/minio.yaml               # Config tĩnh (buckets, ports)
      - values/env/minio.yaml.gotmpl         # Config động từ environments/*.yaml

  # ==========================================================
  # LAYER 03: PROCESSING — Spark Operator
  # ==========================================================
  - name: spark-operator
    namespace: data-processing
    chart: spark-operator/spark-operator
    version: "2.5.0"
    labels:
      layer: "03-processing"
    # Spark Operator image lớn (~200MB từ ghcr.io), pull lần đầu chậm
    timeout: 900
    values:
      - values/base/spark-operator.yaml
      - values/env/spark-operator.yaml.gotmpl

  # ==========================================================
  # LAYER 04: LAKEHOUSE — PostgreSQL (HMS backend)
  # ==========================================================
  # Database backend cho Hive Metastore: lưu catalog metadata (bảng, schema,
  # partition, column stats). Tất cả env dùng Postgres (stg: nhỏ, prd: lớn).
  # HMS bắt buộc cần RDBMS — không thể chạy hoàn toàn in-memory như Nessie.
  - name: hms-postgres
    namespace: data-modeling
    chart: bitnami/postgresql
    version: "15.5.38"
    labels:
      layer: "04-lakehouse"
      component: hms-postgres
    values:
      - values/base/hms-postgres.yaml
      - values/env/hms-postgres.yaml.gotmpl

  # ==========================================================
  # LAYER 04: LAKEHOUSE — Hive Metastore (Iceberg Catalog)
  # ==========================================================
  # Hive Metastore Standalone = Iceberg catalog thay thế Nessie
  # Spark kết nối qua: thrift://hive-metastore.data-modeling.svc:9083
  # Catalog name trong Spark: "lakehouse" (spark.sql.defaultCatalog=lakehouse)
  - name: hive-metastore
    namespace: data-modeling
    chart: ./charts/hive-metastore
    labels:
      layer: "04-lakehouse"
      component: hive-metastore
    # HMS start mất ~60s (schematool init + JARs load)
    wait: false
    atomic: false
    timeout: 600
    needs:
      - data-modeling/hms-postgres
      - data-storage/minio
    values:
      - values/base/hive-metastore.yaml
      - values/env/hive-metastore.yaml.gotmpl

  # ==========================================================
  # LAYER 04: LAKEHOUSE — Spark Thrift Server (dbt SQL gateway)
  # ==========================================================
  # HiveServer2-compatible Spark SQL server, dbt kết nối qua thrift:10000
  # Catalog: lakehouse (Iceberg HiveCatalog → HMS thrift:9083 → Postgres)
  # stg:  local[2] — 1 pod, không executor
  # uat/prd: k8s:// — driver pod + executor pods (Dynamic Allocation)
  - name: spark-thrift-server
    namespace: data-modeling
    chart: ./charts/spark-thrift-server
    labels:
      layer: "04-lakehouse"
      component: spark-thrift-server
    # wait: false vì readinessProbe cần ~90s (JARs download + HiveServer2 init)
    wait: false
    atomic: false
    timeout: 600
    needs:
      - data-modeling/hive-metastore
      - data-storage/minio
    values:
      - values/base/spark-thrift-server.yaml
      - values/env/spark-thrift-server.yaml.gotmpl

  # ==========================================================
  # LAYER 05: GOVERNANCE — DataHub
  # ==========================================================
  # TODO Phase: tạo values/base/datahub-prerequisites.yaml và datahub.yaml rồi bật lại
  # - name: datahub-prerequisites
  #   namespace: data-governance
  #   chart: datahub/datahub-prerequisites
  #   labels:
  #     layer: "05-governance"
  #   values:
  #     - values/base/datahub-prerequisites.yaml
  #
  # - name: datahub
  #   namespace: data-governance
  #   chart: datahub/datahub
  #   labels:
  #     layer: "05-governance"
  #   needs:
  #     - data-governance/datahub-prerequisites
  #   values:
  #     - values/base/datahub.yaml
  #     - values/env/datahub.yaml.gotmpl

  # ==========================================================
  # LAYER 06: ORCHESTRATION — Airflow
  # ==========================================================
  - name: airflow
    namespace: data-orchestration
    chart: airflow/airflow
    version: "1.14.0"
    labels:
      layer: "06-orchestration"
    # wait: false — Airflow chart dùng post-install hook (migrateDatabaseJob) để chạy
    # "airflow db migrate". Nếu wait=true → deadlock: pods chờ migration, migration chờ pods.
    wait: false
    atomic: false
    timeout: 1800
    needs:
      - data-storage/minio
      - data-ingestion/kafka-cluster
    values:
      - values/base/airflow.yaml
      - values/env/airflow.yaml.gotmpl

  # ==========================================================
  # LAYER 07: OBSERVABILITY — Prometheus + Grafana
  # ==========================================================
  # TODO Phase: tạo values/base/prometheus-stack.yaml và values/env/prometheus-stack.yaml.gotmpl rồi bật lại
  # - name: kube-prometheus-stack
  #   namespace: data-observability
  #   chart: prometheus-community/kube-prometheus-stack
  #   version: "60.0.0"
  #   labels:
  #     layer: "07-observability"
  #   values:
  #     - values/base/prometheus-stack.yaml
  #     - values/env/prometheus-stack.yaml.gotmpl

  # ==========================================================
  # LAYER 08: AI SERVICES — thêm sau khi các layer trên stable
  # ==========================================================
