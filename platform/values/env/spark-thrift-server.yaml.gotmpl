# ============================================================
# ENV VALUES — Spark Thrift Server
# ============================================================
# Đọc từ .Values (environments/stg.yaml, uat.yaml, prod.yaml)
# Override values/base/spark-thrift-server.yaml

sparkMaster: {{ .Values.sparkThriftServer.sparkMaster | quote }}

replicaCount: {{ .Values.sparkThriftServer.replicas }}

minio:
  accessKey: {{ .Values.minio.auth.rootUser | quote }}
  secretKey: {{ .Values.minio.auth.rootPassword | quote }}

dynamicAllocation:
  enabled: {{ .Values.sparkThriftServer.dynamicAllocation.enabled }}
  minExecutors: {{ .Values.sparkThriftServer.dynamicAllocation.minExecutors | default 0 }}
  maxExecutors: {{ .Values.sparkThriftServer.dynamicAllocation.maxExecutors }}
  executorIdleTimeout: {{ .Values.sparkThriftServer.dynamicAllocation.executorIdleTimeout | default "60s" | quote }}
  shuffleTracking: true

resources:
  {{- toYaml .Values.sparkThriftServer.resources | nindent 2 }}
