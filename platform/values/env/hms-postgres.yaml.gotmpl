# ============================================================
# ENV VALUES — PostgreSQL (HMS backend)
# ============================================================
# Đọc từ .Values (environments/dev.yaml, uat.yaml, prod.yaml)
# Override values/base/hms-postgres.yaml

{{- if .Values.hms.postgres.useExistingSecret }}
auth:
  existingSecret: {{ .Values.hms.postgres.existingSecret | default "hms-postgres-credentials" }}
  secretKeys:
    adminPasswordKey: postgres-password
    userPasswordKey: password
{{- else }}
auth:
  password: {{ .Values.hms.postgres.password | quote }}
{{- end }}

primary:
  resources:
    {{- toYaml .Values.hms.postgres.resources | nindent 4 }}

  persistence:
    enabled: true
    size: {{ .Values.hms.postgres.storageSize | default "5Gi" }}
    {{- /* get nil-safe: key có thể vắng mặt ở dev/uat (chỉ prod khai báo) */}}
    {{- $sc := .Values | get "hms.postgres.storageClass" "" }}
    {{- if $sc }}
    storageClass: {{ $sc | quote }}
    {{- end }}
